# Copy to .env and adjust. The app reads these at startup.

# Port the web server listens on
PORT=3210

# Bind address. 0.0.0.0 = reachable on the LAN (internal tool).
# Use 127.0.0.1 to restrict to the VM itself.
HOST=0.0.0.0

# Default target size in KB (users can override per job in the UI)
TARGET_KB=500

# Upload limits
MAX_FILE_MB=25
MAX_FILES=20

# JPEG/WebP encoder tuning: max | balanced | fast. Unset = max, which is what
# this tool has always done - highest colour fidelity, no CPU budget. Only set
# this if you are hosting for other people and paying for the cores.
#   max       mozjpeg + 4:4:4 chroma. ~13s CPU per 3.8MP photo.
#   balanced  mozjpeg + 4:2:0 chroma. ~8s, and usually keeps MORE resolution
#             (smaller files let the search stop at a wider size).
#   fast      libjpeg-turbo + 4:2:0.  ~1.3s. Same resolution as max on photos;
#             chroma resolution is halved, which shows on flat-colour graphics.
# ENCODE_PROFILE=max

# Hard cap on in-flight /api/compress requests at once (extra requests get a
# 503 asking the client to retry shortly). Lower this if this app shares a
# box/VM with other services and shouldn't be able to peg all cores.
MAX_CONCURRENT=5

# Video (ffmpeg-based) limits - separate from the image knobs above since
# videos are much larger and slower to process. Size targeting is best-
# effort (see lib/video.js), unlike the image pipeline's guaranteed target.
MAX_VIDEO_MB=500
VIDEO_TARGET_MB=50
MAX_VIDEO_CONCURRENT=1

# ── Branding (all optional) ───────────────────────────────────────────────
# Unset = generic defaults ("Image Resizer", neutral blue). Set any of these
# to re-skin your deployment - no code changes, nothing brand-specific ever
# needs to be committed.
# BRAND_NAME=My Company Resizer
# BRAND_TAGLINE=Custom tagline for your deployment
# BRAND_ACCENT_COLOR=#4f5cfd
# BRAND_HIGHLIGHT_COLOR=#fc5007

# ── Microsoft Entra ID (Azure AD) SSO (all optional) ──────────────────────
# Unset MS_CLIENT_ID = no auth at all (original internal-LAN-tool default).
# Set all five to require Microsoft login before serving the app. Register
# an App Registration in the Azure Portal to get these values - see README.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=
# MS_REDIRECT_URI=http://localhost:3210/auth/callback
# SESSION_SECRET=change-me-to-a-long-random-string
